# 白名單：只納入系統、文件與執行必要素材。
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/CONTRIBUTING.md
!/THIRD_PARTY_NOTICES.md
!/使用說明.txt
!/改版紀錄.md
!/index.html
!/易學版.html
!/.github/
/.github/*
!/.github/PULL_REQUEST_TEMPLATE.md
!/assets/
/assets/*
!/assets/*.js
!/assets/*.css
!/assets/*LICENSE.txt
!/assets/vendor/
/assets/vendor/*
!/assets/vendor/three.min.js
!/assets/vendor/THREE-LICENSE.txt
!/assets/fonts/
/assets/fonts/*
!/assets/fonts/*.css
!/assets/fonts/*.woff2
!/assets/fonts/*LICENSE.txt
!/assets/fonts/OFL.txt
!/assets/fonts/noto-serif-tc/
/assets/fonts/noto-serif-tc/*
!/assets/fonts/noto-serif-tc/*.woff2
!/assets/easy/
/assets/easy/*
!/assets/easy/pics/
/assets/easy/pics/*
!/assets/easy/pics/*.png
!/assets/easy/pics/*.jpg
!/assets/easy/pics/*.txt
!/assets/book/
/assets/book/*
!/assets/book/p*.jpg
!/assets/book/成品範例_看手機與玩遊戲的規則.pdf
!/assets/sample/
/assets/sample/*
!/assets/sample/*.jpg
!/assets/sample/*.svg

# 即使新增允許目錄，也不提交憑證、環境或瀏覽器資料。
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.log
**/*.bak
**/*.db
**/*.sqlite
**/Thumbs.db
**/.DS_Store
